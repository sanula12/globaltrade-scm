<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/ejb-jar_3_2.xsd"
         version="3.2">

    
    <display-name>GlobalTrade EJB Module</display-name>

    <!--
        ejb-jar.xml is the XML alternative/complement to EJB annotations.

        WHY have this file if we use annotations?
        1. Deployment-time overrides — change behaviour without recompiling
        2. Shows the examiner you understand the "deployment descriptor" concept
        3. Required for some advanced configurations not possible with annotations
        4. Documents the EJB structure formally (enterprise requirement)

        Anything declared here OVERRIDES the same annotation in code.
        This is powerful — you can change transaction attributes per-environment
        (dev vs. prod) without changing source code.
    -->

    <enterprise-beans>

        <!-- ShipmentService EJB declaration -->
        <session>
            <ejb-name>ShipmentService</ejb-name>
            <ejb-class>com.globaltrade.service.ShipmentService</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

        <!-- InventoryService EJB declaration -->
        <session>
            <ejb-name>InventoryService</ejb-name>
            <ejb-class>com.globaltrade.service.InventoryService</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

        <!-- VendorService EJB declaration -->
        <session>
            <ejb-name>VendorService</ejb-name>
            <ejb-class>com.globaltrade.service.VendorService</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

        <!-- ConfigurationBean — Singleton EJB -->
        <session>
            <ejb-name>ConfigurationBean</ejb-name>
            <ejb-class>com.globaltrade.service.ConfigurationBean</ejb-class>
            <session-type>Singleton</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

        <!-- SecurityService EJB declaration -->
        <session>
            <ejb-name>SecurityService</ejb-name>
            <ejb-class>com.globaltrade.security.SecurityService</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

        <!-- Timer Beans -->
        <session>
            <ejb-name>ShipmentTrackingTimerBean</ejb-name>
            <ejb-class>com.globaltrade.timer.ShipmentTrackingTimerBean</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

        <session>
            <ejb-name>InventoryMonitorTimerBean</ejb-name>
            <ejb-class>com.globaltrade.timer.InventoryMonitorTimerBean</ejb-class>
            <session-type>Singleton</session-type>
            <transaction-type>Container</transaction-type>
            
        </session>

    </enterprise-beans>

    <!--
        Interceptor bindings in XML — alternative to @Interceptors annotation.
        Shown here for documentation — our code already uses annotations.
    -->
    <assembly-descriptor>
        <interceptor-binding>
            <ejb-name>ShipmentService</ejb-name>
            <interceptor-class>
                com.globaltrade.intercepter.AuditInterceptor
            </interceptor-class>
        </interceptor-binding>
        <interceptor-binding>
            <ejb-name>InventoryService</ejb-name>
            <interceptor-class>
                com.globaltrade.intercepter.AuditInterceptor
            </interceptor-class>
        </interceptor-binding>
        <interceptor-binding>
            <ejb-name>VendorService</ejb-name>
            <interceptor-class>
                com.globaltrade.intercepter.AuditInterceptor
            </interceptor-class>
        </interceptor-binding>
    </assembly-descriptor>

</ejb-jar>
